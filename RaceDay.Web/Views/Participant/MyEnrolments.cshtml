@model List<RaceDay.Web.Controllers.ParticipantController.MyEnrolmentViewModel>

@{
    ViewData["Title"] = "My Enrolments";
}

<div class="container mt-4">
    <h2>My RaceDay Enrolments</h2>

    <p class="text-muted">
        View the running, walking and cycling events
        you have registered for.
    </p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">
            You have not enrolled in any events yet.
        </div>

        <a asp-controller="Events"
           asp-action="Index"
           class="btn btn-primary">
            Explore Events
        </a>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Category</th>
                        <th>Distance</th>
                        <th>Entry Fee</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var enrolment in Model)
                    {
                        <tr>
                            <td>@enrolment.EventName</td>
                            <td>
                                @enrolment.EventDate.ToString("dd MMM yyyy")
                            </td>
                            <td>@enrolment.Location</td>
                            <td>@enrolment.CategoryName</td>
                            <td>@enrolment.DistanceKm km</td>
                            <td>
                                R @enrolment.EntryFee.ToString("0.00")
                            </td>
                            <td>
                                <span class="badge bg-primary">
                                    @enrolment.Status
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <a asp-controller="Participant"
       asp-action="Index"
       class="btn btn-secondary mt-3">
        Back to Dashboard
    </a>
</div>

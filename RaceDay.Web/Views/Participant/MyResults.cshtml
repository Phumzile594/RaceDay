@model List<RaceDay.Web.Controllers.ParticipantController.MyResultViewModel>

@{
    ViewData["Title"] = "My Results";
}

<div class="container mt-4 mb-5">

    <h2>🏅 My RaceDay Results</h2>

    <p class="text-muted">
        View your finishing times, positions and race achievements.
    </p>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">
            No race results have been recorded for you yet.
            Your results will appear here after the
            event Organiser records them.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Category</th>
                        <th>Distance</th>
                        <th>Finish Time</th>
                        <th>Position</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var result in Model)
                    {
                        <tr>
                            <td>@result.EventName</td>

                            <td>
                                @result.EventDate.ToString("dd MMM yyyy")
                            </td>

                            <td>@result.CategoryName</td>

                            <td>@result.DistanceKm km</td>

                            <td>
                                @result.FinishTime.ToString(@"hh\:mm\:ss")
                            </td>

                            <td>@result.Position</td>

                            <td>
                                <span class="badge bg-success">
                                    @result.ResultStatus
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <a asp-controller="Participant"
       asp-action="Index"
       class="btn btn-secondary mt-3">
        Back to Dashboard
    </a>

</div>

@model RaceDay.Web.Models.EventFormViewModel

@{
    ViewData["Title"] = "Delete Event";
}

<div class="container mt-4">
    <h2 class="text-danger">Delete RaceDay Event</h2>

    <div class="alert alert-warning mt-3">
        <strong>Warning!</strong>
        Are you sure you want to delete this event?
        This action cannot be undone.
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h4>@Model.EventName</h4>

            <p>
                <strong>Description:</strong>
                @Model.Description
            </p>

            <p>
                <strong>Date:</strong>
                @Model.EventDate.ToString("dd MMM yyyy")
            </p>

            <p>
                <strong>Location:</strong>
                @Model.Location
            </p>

            <p>
                <strong>Distance:</strong>
                @Model.DistanceKm km
            </p>

            <p>
                <strong>Event Type:</strong>
                @Model.EventType
            </p>
        </div>
    </div>

    <form asp-controller="Organiser"
          asp-action="DeleteEvent"
          asp-route-id="@Model.EventID"
          method="post">

        @Html.AntiForgeryToken()

        <button type="submit" class="btn btn-danger">
            Yes, Delete Event
        </button>

        <a asp-controller="Events"
           asp-action="Index"
           class="btn btn-secondary ms-2">
            Cancel
        </a>
    </form>
</div>
